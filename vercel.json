{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "services": {
      "frontend": {
        "root": "frontend",
        "framework": "vite"
      },
      "backend": {
        "root": "backend",
        "framework": "fastapi",
        "entrypoint": "app.main:app"
      }
    },
    "rewrites": [
      {
        "source": "/documents/(.*)",
        "destination": {
          "service": "backend"
        }
      },
      {
        "source": "/docs",
        "destination": {
          "service": "backend"
        }
      },
      {
        "source": "/openapi.json",
        "destination": {
          "service": "backend"
        }
      },
      {
        "source": "/redoc",
        "destination": {
          "service": "backend"
        }
      },
      {
        "source": "/(.*)",
        "destination": {
          "service": "frontend"
        }
      }
    ]
  }
  